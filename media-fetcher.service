[Unit]
Description=Floor555
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/floor555.gotunda.com
ExecStart=/var/www/floor555.gotunda.com/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
Environment="PATH=/var/www/floor555.gotunda.com/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="XDG_CONFIG_HOME=/tmp" "XDG_CACHE_HOME=/tmp" "XDG_DATA_HOME=/tmp"

# Harden the process
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/floor555.gotunda.com/downloads

[Install]
WantedBy=multi-user.target
